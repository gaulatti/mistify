#!/usr/bin/env bash
set -euo pipefail
# Agent setup is intentionally independent of repository CI configuration.
if [[ "${GITHUB_ACTIONS:-false}" == 'true' ]]; then
  exit 0
fi
installer="$(mktemp "${TMPDIR:-/tmp}/clouseau-bootstrap.XXXXXX")"
trap 'rm -f "${installer}"' EXIT
curl --fail --silent --show-error --location \
  'https://raw.githubusercontent.com/gaulatti/clouseau/main/scripts/install-agent' \
  --output "${installer}"
bash -n "${installer}"
bash "${installer}"
